// Esmeworld sync server (Cloudflare Worker + D1).
// Contract: docs/superpowers/specs/2026-10-28-sync-api.md
//
// ALWAYS run wrangler with an explicit `--config /absolute/path/sync/wrangler.jsonc`.
// The repo-root wrangler.jsonc belongs to a different (legacy) worker and wrangler
// walks UP the directory tree looking for a config if none is given.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "esmeworld-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Observability, set explicitly. Our own logs (only a fixed failure code, never headers or
  // bodies) are kept. Invocation logs and traces are OFF: they record per-request metadata,
  // and wrangler offers no switch to exclude request headers (Authorization) from them.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "esmeworld-sync",
      // PLACEHOLDER: replace with the real id printed by `wrangler d1 create`.
      "database_id": "4c51585e-306e-4454-a450-a3a290f100aa",
      "migrations_dir": "migrations"
    }
  ],
  // Due reminders (src/due/cron.ts). EXACTLY ONE cron trigger: the free plan allows 5 per
  // account and the legacy worker (repo-root wrangler.jsonc) uses 4.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Due's public address (a Tailscale Funnel; not a secret). The token is a secret: DUE_TOKEN.
  "vars": { "DUE_BASE_URL": "https://wsl-esme-1.tailc6cd5d.ts.net" }
  // Secrets (never committed): SYNC_TOKEN_HASH (set with tools/set-passphrase.mjs);
  // DUE_TOKEN (wrangler secret put DUE_TOKEN; without it no reminder is ever sent).
}
