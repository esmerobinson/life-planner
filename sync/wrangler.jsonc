// Esmeworld sync server (Cloudflare Worker + D1).
// Contract: docs/superpowers/specs/2026-10-28-sync-api.md
//
// ALWAYS run wrangler with an explicit `--config /absolute/path/sync/wrangler.jsonc`.
// The repo-root wrangler.jsonc belongs to a different (legacy) worker and wrangler
// walks UP the directory tree looking for a config if none is given.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "esmeworld-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "esmeworld-sync",
      // PLACEHOLDER: replace with the real id printed by `wrangler d1 create`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
  // Secret (set with tools/set-passphrase.mjs, never committed): SYNC_TOKEN_HASH
}
